{
	"name": "gchape.github.io",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && node scripts/prerender.mjs && pnpm resume",
		"lint": "biome lint . --error-on-warnings",
		"preview": "vite preview",
		"check": "biome check . --error-on-warnings",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc -b",
		"test": "node --test src/features/blog/content/post-metadata.test.mjs",
		"unused": "knip",
		"resume": "tsx --tsconfig tsconfig.app.json scripts/generate-resume.tsx"
	},
	"knip": {
		"entry": [
			"src/entry-server.tsx"
		]
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.71.0",
		"mermaid": "^12.3.0",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"valibot": "^1.5.0",
		"wouter": "^3.13.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@react-pdf/renderer": "^4.9.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"cheerio": "^1.2.0",
		"gray-matter": "^4.0.3",
		"knip": "^6.45.0",
		"reading-time": "^1.5.0",
		"shadcn": "^4.23.0",
		"sitemap": "^10.0.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.7"
	},
	"packageManager": "pnpm@12.18.0"
}
