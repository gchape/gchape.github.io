{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/dist",
			"!!**/dist-ssr",
			"!!**/coverage",
			"!!**/pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"tailwind": {
		"stylesheet": "./src/index.css"
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": [
				"src/components/content/mermaid-diagram.tsx",
				"src/components/ui/code-block.tsx"
			],
			"linter": {
				"rules": {
					"a11y": {
						"noNoninteractiveTabindex": "off"
					}
				}
			}
		}
	],
	"markdown": {
		"parser": {
			"frontmatter": true
		},
		"formatter": {
			"enabled": true,
			"proseWrap": "preserve"
		}
	}
}
